# ==============================================================================
# PRODUCTION MODE (.env.production)
# Copy ke .env.production di VPS & Node Lokal. JANGAN PERNAH commit file .env.production!
# ==============================================================================
NODE_ENV=production
PORT=3001

# WAJIB 'real' di production (server akan gagal start jika bernilai 'mock')
DATA_SOURCE_MODE=real
KALODATA_MODE=real
LLM_MODE=real
TTS_MODE=real
META_API_MODE=real
SKIP_QUEUE_CONNECTION=false

# PostgreSQL & Redis VPS (hanya bind ke 127.0.0.1 & IP Tailscale)
DATABASE_URL=postgresql://ebieshop:STRONG_PASSWORD@127.0.0.1:5432/ebieshop
REDIS_URL=redis://127.0.0.1:6379

# Local Worker -> VPS via HTTPS / Tailscale
VPS_API_URL=https://api.domain-anda.com
RAW_MEDIA_DIR=D:\ebieshop-media\raw
PLAYWRIGHT_HEADLESS=true

# Production Secrets (generate acak minimal 32 byte)
ADMIN_JWT_SECRET=
WORKER_SHARED_SECRET=
TOKEN_ENCRYPTION_KEY=

# External API Keys
KALODATA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=ebieshop-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
