# ==============================================================================
# DEVELOPMENT MODE (.env.development.example)
# Copy file ini menjadi .env.development lalu isi value yang diperlukan.
# ==============================================================================

# --- 1. Server & Mode Kontrol ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
DATA_SOURCE_MODE=mock
KALODATA_MODE=mock
LLM_MODE=mock
TTS_MODE=mock
META_API_MODE=mock
SKIP_QUEUE_CONNECTION=true

# --- 2. Database & Redis Lokal (docker-compose.dev.yml) ---
DATABASE_URL=postgresql://ebieshop:ebieshop_dev_password@127.0.0.1:5432/ebieshop
REDIS_URL=redis://127.0.0.1:6379

# --- 3. Auth & Security Secrets (HANYA untuk development lokal) ---
ADMIN_JWT_SECRET=dev-admin-jwt-secret-minimum-32-chars
WORKER_SHARED_SECRET=dev-worker-shared-secret-minimum-32-chars
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- 4. Kalodata Open API (KALODATA_MODE=real) ---
KALODATA_API_KEY=
KALODATA_BASE_URL=https://api.kalodata.com/v1

# --- 5. LLM Script Generator (LLM_MODE=real: isi minimal salah satu) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- 6. Object Storage (MinIO Lokal / Cloudflare R2) ---
R2_ENDPOINT=http://127.0.0.1:9000
R2_BUCKET=ebieshop-media
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_BASE_URL=http://127.0.0.1:9000/ebieshop-media

# --- 7. Meta Graph API & Webhook IG/FB (META_API_MODE=real) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=dev-meta-verify-token
META_PAGE_ACCESS_TOKEN=
META_OWN_IG_USER_ID=
META_OWN_PAGE_ID=
THREADS_MODE=mock
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_DISPLAY_NAME=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_REDIRECT_URI=https://localhost:3000/products/threads

# --- 8. YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=

# --- 9. Telegram Alert Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- 10. Local Worker, TTS & Playwright ---
VPS_API_URL=http://127.0.0.1:3001
RAW_MEDIA_DIR=./raw_media_dir
PYTHON_BIN=python
ELEVENLABS_API_KEY=
PLAYWRIGHT_HEADLESS=false

# --- 11. Frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=http://127.0.0.1:9000/ebieshop-media

# --- 12. Link Bio ---
LNKBIO_CLIENT_ID=
LNKBIO_CLIENT_SCREET=
