# ==============================================================================
# DEVELOPMENT MODE (.env.development)
# Copy file ini menjadi .env.development untuk menjalankan aplikasi secara lokal
# ==============================================================================
NODE_ENV=development
PORT=3001

# Gunakan 'mock' untuk membaca JSON dummy dari packages/mocks/json/
DATA_SOURCE_MODE=mock
KALODATA_MODE=mock
LLM_MODE=mock
TTS_MODE=mock
META_API_MODE=mock

# Opsional: set 'true' jika ingin menjalankan backend tanpa Docker Redis lokal
SKIP_QUEUE_CONNECTION=true

# Database & Redis Lokal (docker-compose.dev.yml)
DATABASE_URL=postgresql://ebieshop:ebieshop_dev_password@127.0.0.1:5432/ebieshop
REDIS_URL=redis://127.0.0.1:6379

# Local Worker
VPS_API_URL=http://127.0.0.1:3001
RAW_MEDIA_DIR=./raw_media_dir
PLAYWRIGHT_HEADLESS=false

# Dev Secrets (HANYA untuk development lokal)
ADMIN_JWT_SECRET=dev-admin-jwt-secret-minimum-32-chars
WORKER_SHARED_SECRET=dev-worker-shared-secret-minimum-32-chars
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
