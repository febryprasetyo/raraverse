{
  "name": "@ebieshop/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=../../.env.development src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node --env-file=../../.env.production dist/index.js",
    "login:shopee": "tsx src/playwright/login-cli.ts shopee",
    "login:tiktok": "tsx src/playwright/login-cli.ts tiktok"
  },
  "dependencies": {
    "@ebieshop/mocks": "workspace:*",
    "@ebieshop/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
