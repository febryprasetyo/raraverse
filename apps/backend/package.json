{
  "name": "@ebieshop/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=../../.env.development src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node --env-file=../../.env.production dist/server.js"
  },
  "dependencies": {
    "@ebieshop/db": "workspace:*",
    "@ebieshop/mocks": "workspace:*",
    "@ebieshop/shared": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "bullmq": "^5.51.0",
    "fastify": "^5.3.3",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
