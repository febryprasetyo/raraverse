{
  "name": "ebieshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d postgres redis minio minio-init",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:backend": "pnpm --filter @ebieshop/backend dev",
    "dev:frontend": "pnpm --filter @ebieshop/frontend dev",
    "dev:worker": "pnpm --filter @ebieshop/worker dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "cross-env NODE_ENV=test pnpm -r --if-present test",
    "test:watch": "cross-env NODE_ENV=test pnpm -r --if-present test:watch",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:check",
    "build": "pnpm -r --if-present build",
    "start:backend": "pnpm --filter @ebieshop/backend start",
    "start:worker": "pnpm --filter @ebieshop/worker start",
    "db:generate": "pnpm --filter @ebieshop/db db:generate",
    "db:check": "pnpm --filter @ebieshop/db db:check",
    "db:migrate": "pnpm --filter @ebieshop/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}